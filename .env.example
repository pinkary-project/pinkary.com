APP_NAME=Pinkary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://pinkary.com
# Hosts, comma separated, that AbsoluteUrl may rebuild media URLs onto when
# they differ from APP_URL's. Leave empty unless the API is reached by another
# name (a phone on the local network, a separate API hostname). A forged Host
# or X-Forwarded-Host cannot repoint media URLs unless it is listed here.
APP_TRUSTED_HOSTS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
FORWARD_DB_PORT=3306

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="team@pinkary.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

MAILCOACH_TOKEN=
PENNANT_STORE=array

RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_SECRET=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=
LEMON_SQUEEZY_PATH=

GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

SPONSORS_GITHUB_USERNAMES=
SPONSORS_GITHUB_COMPANY_USERNAMES=

DEBUGBAR_ENABLED=
DEBUGBAR_THEME=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
# Public base URL for the S3 bucket, used by Storage::url() to build every
# image and avatar URL. Required with FILESYSTEM_DISK=s3. Comment it out
# rather than leaving it blank: an empty value is "set" as far as the disk
# config is concerned, and Storage::url() then returns a root-relative path
# instead of a fetchable URL.
# AWS_URL=https://cdn.example.com
AWS_USE_PATH_STYLE_ENDPOINT=false
